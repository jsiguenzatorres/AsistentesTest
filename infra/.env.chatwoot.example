# Variables para chatwoot-rails / chatwoot-sidekiq / chatwoot-redis (ver
# referencia completa: https://github.com/chatwoot/chatwoot/blob/develop/.env.example)
# Copiar a infra/.env.chatwoot y completar antes de `docker compose up`.

# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=cambia-esto-por-un-hex-largo-y-aleatorio

FRONTEND_URL=https://tu-dominio-chatwoot.example.com
DEFAULT_LOCALE=es
MAILER_SENDER_EMAIL=Fuerza Laboral Virtual <soporte@tu-dominio.example.com>

# Debe coincidir con el nombre del servicio chatwoot-postgres en docker-compose.yml
POSTGRES_HOST=chatwoot-postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=cambia-esta-clave
CHATWOOT_POSTGRES_PASSWORD=cambia-esta-clave

# Debe coincidir con el nombre del servicio chatwoot-redis
REDIS_URL=redis://chatwoot-redis:6379
REDIS_PASSWORD=cambia-esta-clave

RAILS_MAX_THREADS=5

# SMTP para notificaciones por correo (opcional para el prototipo; sin esto
# Chatwoot funciona igual, solo no enviará emails transaccionales)
SMTP_DOMAIN=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
