# Variables para el servicio evolution-api (ver referencia completa:
# https://github.com/evolution-foundation/evolution-api/blob/main/.env.example)
# Copiar a infra/.env.evolution y completar antes de `docker compose up`.

SERVER_URL=https://tu-dominio-evolution.example.com

# Credenciales del Postgres propio de Evolution API (mismos valores para
# el contenedor evolution-postgres y para la URI de conexión de abajo).
EVOLUTION_POSTGRES_DB=evolution_db
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=cambia-esta-clave

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:cambia-esta-clave@evolution-postgres:5432/evolution_db?schema=evolution_api

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution

# Clave que usará nuestro asistente (apps/asistente-virtual) y Chatwoot
# para autenticarse contra la API de Evolution. Generar una nueva, no usar la de ejemplo.
AUTHENTICATION_API_KEY=cambia-esta-api-key

LANGUAGE=es

# Se activa cuando ya tengas Chatwoot corriendo, para que cada mensaje
# entrante de WhatsApp llegue a la bandeja omnicanal.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
