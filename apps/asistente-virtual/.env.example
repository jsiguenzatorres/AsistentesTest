# Canal a levantar cuando se corre `npm run dev:whatsapp` / `npm run dev:telegram`
CHANNEL=whatsapp

# Puerto del servidor HTTP de BuilderBot (QR de WhatsApp, webhooks)
PORT=3008

# --- LLM (cerebro del agente) ---
# Sin esta key el prototipo responde en "modo demo" (reglas simples, sin IA real).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Solo si usas un proxy/gateway propio hacia la API de Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Telegram (solo si CHANNEL=telegram) ---
TELEGRAM_BOT_TOKEN=
